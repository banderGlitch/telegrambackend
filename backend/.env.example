# --- Telegram ---
# Same bot token the bot itself uses. Required for HMAC verification of
# initData. Get it from @BotFather.
TELEGRAM_BOT_TOKEN=your-bot-token-here

# --- Database ---
# Local dev (no setup): defaults to sqlite below if unset.
# Production (Railway): the DATABASE_URL is injected by Railway when you
# attach a Postgres plugin. It looks like:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///./dev.db

# --- Optional Redis (Railway: add Redis plugin, reference REDIS_URL) ---
# Leave empty to disable. Used for a short-lived leaderboard row cache.
# REDIS_URL=redis://default:password@host:6379
# REDIS_LEADERBOARD_TTL_SECONDS=60

# --- CORS ---
# Comma-separated list of origins allowed to call the API (no spaces).
# Production on Railway: include your real Mini App URL, e.g.:
#   ALLOWED_ORIGINS=https://galaticadventures.vercel.app
# Local dev + Mini App + **admin dashboard** (Vite defaults to port 5174):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://galaticadventures.vercel.app

# --- Admin dashboard JWT login (`admin/` SPA) ---
# Generate a long random secret, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
# Single shared password for operators (use a strong unique value in production).
ADMIN_DASHBOARD_PASSWORD=change-me
# Optional session length (hours).
ADMIN_JWT_EXPIRE_HOURS=8

# --- App behavior ---
LOG_LEVEL=INFO
# Set to "true" in production to require valid Telegram initData on every
# protected request. In development you may set this to "false" so you can
# hit the API from a plain browser without Telegram.
REQUIRE_TELEGRAM_AUTH=false

# --- Anti-cheat thresholds (optional overrides) ---
# Minimum run duration before a score will be accepted (ms).
ANTICHEAT_MIN_RUN_MS=2000
# Hard cap on points-per-second; runs above this are rejected as implausible.
ANTICHEAT_MAX_SCORE_PER_SECOND=80
