# Copy this file to ".env" and fill in your real values.
# Never commit your real .env file.

# Get this token from @BotFather on Telegram (see README.md).
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# HTTPS URL where the Mini App (webapp/) is served.
# Example (this project): https://galaticadventures.vercel.app
WEBAPP_URL=https://galaticadventures.vercel.app
